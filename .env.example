# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional public URL of the Roomly API gateway in deployed environments.
# Leave empty during local development to use Vite's same-origin service proxies.
# Example: https://api.roomly.example.com
VITE_API_BASE_URL=""

# Optional overrides for `pnpm dev`; put them in .env.local.
# DEV_PORT: dev server port (default 3000). Change it when Docker's
# roomly-frontend already serves localhost:3000.
# ROOMLY_GATEWAY_URL: where Vite proxies API calls (default http://127.0.0.1:8080).
# If the gateway isn't published on the host, the Docker frontend on port 3000 can proxy it.
# ROOMLY_ALLOWED_ORIGIN: the backend's APP_CORS_ALLOWED_ORIGIN, sent as the Origin
# header when the dev port differs from it; without it, POST requests get a 403.
# DEV_PORT=3001
# ROOMLY_GATEWAY_URL=http://127.0.0.1:8080
# ROOMLY_ALLOWED_ORIGIN=http://localhost:3000

# VITE_GOOGLE_CLIENT_ID: Google OAuth 2.0 Client ID used for "Continue with
# Google" in the auth modal (Google Identity Services ID-token flow).
# Create one at https://console.cloud.google.com/apis/credentials
# (Application type: Web application, Authorized JavaScript origin:
# http://localhost:3000 or wherever the dashboard runs).
# The SAME client ID must also be set as GOOGLE_CLIENT_ID in Roomly's
# auth-service .env, since the backend verifies the token's audience against it.
VITE_GOOGLE_CLIENT_ID=""
